<Window x:Class="WiFiChecker.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi アクセスポイント チェッカー セットアップ"
        Height="460" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Yu Gothic UI">
    
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wi-Fi アクセスポイント チェッカー" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="セットアップ ウィザード" Foreground="#94A3B8" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <Image Grid.Column="1" Source="pack://application:,,,/Resources/app.ico" Width="48" Height="48" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Body Step 1: Settings -->
        <Grid x:Name="Step1Grid" Grid.Row="1" Margin="30,20,30,10" Visibility="Visible">
            <StackPanel>
                <TextBlock Text="インストール先フォルダーの選択" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="以下のフォルダーにアプリケーションをインストールします。" FontSize="12" Foreground="#64748B" Margin="0,4,0,10"/>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" FontSize="13" Padding="8,6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="参照..." Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnBrowseClick"/>
                </Grid>

                <TextBlock Text="追加のタスク" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <CheckBox x:Name="DesktopShortcutCheck" Content="デスクトップにショートカットを作成する" IsChecked="True" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartMenuShortcutCheck" Content="スタートメニューに登録する" IsChecked="True" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="LaunchAfterCheck" Content="インストール完了後に起動する" IsChecked="True" FontSize="13" Margin="0,0,0,8"/>
            </StackPanel>
        </Grid>

        <!-- Body Step 2: Progress -->
        <Grid x:Name="Step2Grid" Grid.Row="1" Margin="30,40,30,10" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="インストールしています..." FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,15"/>
                <ProgressBar x:Name="InstallProgressBar" Height="14" IsIndeterminate="True" Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" Text="準備中..." FontSize="12" Foreground="#64748B" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Body Step 3: Finished -->
        <Grid x:Name="Step3Grid" Grid.Row="1" Margin="30,30,30,10" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✔" FontSize="48" Foreground="#10B981" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="セットアップが完了しました" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Wi-Fi アクセスポイント チェッカー のインストールが正常に終了しました。" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="キャンセル" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnCancelClick"/>
                    <Button x:Name="NextButton" Content="インストール" Style="{StaticResource ModernButton}" Click="OnInstallClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
