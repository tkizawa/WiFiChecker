<Window x:Class="WiFiChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WiFiChecker"
        mc:Ignorable="d"
        Title="Wi-Fi Access Point Checker"
        Height="680" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        Icon="Resources/app.ico">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダーバー -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/app.ico" Width="28" Height="28" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitleText" Text="{Binding Loc.AppTitle, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="18" FontWeight="Bold" Foreground="#111827" />
                        <TextBlock x:Name="HeaderSubtitleText" Text="{Binding Loc.HeaderSubTitle, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="#6B7280" />
                    </StackPanel>
                </StackPanel>

                <!-- アクションボタン領域 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnRefreshClick" Padding="12,6" Margin="0,0,8,0" Background="#F3F4F6" BorderBrush="#D1D5DB" Cursor="Hand">
                        <TextBlock x:Name="BtnRefreshText" Text="更新" FontSize="13" />
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="AutoRefreshLabelText" Text="自動更新:" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#374151" />
                        <CheckBox x:Name="AutoRefreshCheck" IsChecked="True" Click="OnAutoRefreshCheckChanged" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="IntervalCombo" SelectionChanged="OnIntervalChanged" Width="80" Height="28">
                            <ComboBoxItem Content="1 秒" Tag="1" />
                            <ComboBoxItem Content="2 秒" Tag="2" />
                            <ComboBoxItem Content="5 秒" Tag="5" IsSelected="True" />
                            <ComboBoxItem Content="10 秒" Tag="10" />
                            <ComboBoxItem Content="30 秒" Tag="30" />
                        </ComboBox>
                    </StackPanel>

                    <Button Click="OnCopyAllClick" Padding="12,6" Margin="0,0,8,0" Background="#0078D4" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <TextBlock x:Name="BtnCopyText" Text="全情報をコピー" FontSize="13" />
                    </Button>

                    <Button Click="OnSettingsClick" Padding="10,6" Background="#F3F4F6" BorderBrush="#D1D5DB" Cursor="Hand">
                        <TextBlock Text="⚙" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel x:Name="MainContentStack">

                <!-- コピー通知 Toast -->
                <Border x:Name="NotificationBorder" Background="#D1FAE5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="NotificationText" Text="クリップボードにコピーしました" Foreground="#065F46" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Border>

                <!-- 1. メイン接続ステータスカード -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <!-- 左側: SSID & ステータス -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusText" Text="接続中" FontSize="13" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock x:Name="SsidText" Text="Wi-Fi Network" FontSize="28" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BSSID (MAC): " FontSize="12" Foreground="#6B7280" />
                                <TextBlock x:Name="BssidText" Text="00:00:00:00:00:00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,20,0" />

                                <TextBlock Text="周波数帯: " FontSize="12" Foreground="#6B7280" />
                                <TextBlock x:Name="BandText" Text="5 GHz (Ch 36)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 右側: 電波強度メーター -->
                        <Border Grid.Column="1" Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="16,0,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="LabelSignalText" Text="電波強度 (Signal)" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock x:Name="SignalPercentText" Text="85" FontSize="36" FontWeight="Bold" Foreground="#111827" />
                                    <TextBlock Text="%" FontSize="18" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                                </StackPanel>
                                <ProgressBar x:Name="SignalProgressBar" Value="85" Maximum="100" Height="8" Foreground="#0078D4" Background="#E5E7EB" Margin="0,0,0,6" />
                                <TextBlock x:Name="SignalDbmText" Text="-55 dBm" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. 無線スペック & セキュリティ -->
                <TextBlock x:Name="SectionWirelessText" Text="無線スペック &amp; セキュリティ" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock x:Name="LabelPhyTypeText" Text="Wi-Fi 規格 (PHY)" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBlock x:Name="PhyTypeText" Text="802.11ax (Wi-Fi 6)" FontSize="14" FontWeight="Bold" Foreground="#111827" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,12">
                        <StackPanel>
                            <TextBlock x:Name="LabelChannelText" Text="周波数・チャンネル" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBlock x:Name="ChannelDetailText" Text="Ch 36 (5.180 GHz)" FontSize="14" FontWeight="Bold" Foreground="#111827" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="LabelSecurityText" Text="認証・暗号化" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                            <TextBlock x:Name="SecurityText" Text="WPA2-Personal / AES" FontSize="14" FontWeight="Bold" Foreground="#111827" />
                        </StackPanel>
                    </Border>

                    <!-- リンク速度 -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LabelRxSpeedText" Text="受信速度 (Rx)" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBlock x:Name="RxSpeedText" Text="1201 Mbps" FontSize="16" FontWeight="Bold" Foreground="#10B981" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LabelTxSpeedText" Text="送信速度 (Tx)" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxSpeedText" Text="1201 Mbps" FontSize="16" FontWeight="Bold" Foreground="#0078D4" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. ネットワーク & IP設定 -->
                <TextBlock x:Name="SectionNetworkText" Text="ネットワーク &amp; IP 設定" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <!-- IPv4 / Subnet -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LabelIpv4Text" Text="IPv4 アドレス" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2" />
                                <TextBlock x:Name="Ipv4Text" Text="192.168.1.100" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LabelSubnetText" Text="サブネット マスク" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2" />
                                <TextBlock x:Name="SubnetText" Text="255.255.255.0" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="#E5E7EB" Margin="0,0,0,12" />

                        <!-- Gateway / DNS -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LabelGatewayText" Text="デフォルト ゲートウェイ" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2" />
                                <TextBlock x:Name="GatewayText" Text="192.168.1.1" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="#374151" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LabelDnsText" Text="DNS サーバー" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2" />
                                <TextBlock x:Name="DnsText" Text="192.168.1.1, 8.8.8.8" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="#374151" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="#E5E7EB" Margin="0,0,0,12" />

                        <!-- IPv6 / Adapter -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LabelIpv6Text" Text="IPv6 アドレス" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2" />
                                <TextBlock x:Name="Ipv6Text" Text="fe80::1234:5678:9abc:def0" FontFamily="Consolas" FontSize="13" Foreground="#6B7280" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LabelAdapterText" Text="ネットワーク アダプター" FontSize="11" Foreground="#6B7280" Margin="0,0,0,2" />
                                <TextBlock x:Name="AdapterText" Text="Wi-Fi Adapter" FontSize="13" Foreground="#374151" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- フッター -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock x:Name="LastUpdatedText" Text="最終更新: 2026-09-02 23:30:00" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" />
                <TextBlock Text="WiFiChecker v1.0.0.0" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 設定モーダル Overlay -->
        <Grid x:Name="SettingsModal" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="8" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="SettingsModalTitle" Text="設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
                    
                    <TextBlock x:Name="LabelLanguageSettingText" Text="表示言語 (Language)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="LangSettingCombo" SelectionChanged="OnLangSettingChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="OSの設定に合わせる (Auto)" Tag="auto" />
                        <ComboBoxItem Content="日本語 (Japanese)" Tag="ja-JP" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>

                    <Separator Background="#E5E7EB" Margin="0,0,0,16" />

                    <!-- CSVロギング設定 -->
                    <TextBlock Text="CSV ロギング" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <CheckBox x:Name="EnableLoggingCheck" Click="OnEnableLoggingCheckChanged" Margin="0,0,0,10">
                        <TextBlock x:Name="LabelCsvLoggingText" Text="更新時にCSVログを記録する" FontSize="13" VerticalAlignment="Center" />
                    </CheckBox>

                    <Button Click="OnOpenLogFolderClick" Padding="10,6" Margin="0,0,0,20" Background="#F3F4F6" BorderBrush="#D1D5DB" HorizontalAlignment="Left" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="BtnOpenLogFolderText" Text="ログフォルダーを開く" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnCloseSettingsClick" Padding="16,8" Background="#0078D4" Foreground="#FFFFFF" BorderThickness="0" HorizontalAlignment="Right" FontWeight="SemiBold" Cursor="Hand">
                        <TextBlock x:Name="BtnCloseText" Text="閉じる" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
